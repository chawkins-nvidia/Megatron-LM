{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab-master.nvidia.com/chawkins/scaling/schemas/diag_v2.artifact.schema.json",
  "title": "diag/v2 all-layer event artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "successful_update", "consumed_tokens", "event_id",
    "requested_tier", "effective_tier", "require_tier", "status", "status_reason",
    "run_identity", "capability_signature", "capability_status", "capability_allow",
    "topology", "sampling", "digests", "enums", "files", "state_snapshots",
    "restore_evidence", "process_groups",
    "artifact_bytes", "repro"
  ],
  "properties": {
    "schema": {"const": "diag/v2/artifact"},
    "successful_update": {"type": "integer", "minimum": 1},
    "consumed_tokens": {"type": "integer", "minimum": 0},
    "event_id": {"type": "integer", "minimum": 1},
    "requested_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "effective_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "require_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "status": {"enum": ["ok", "degraded", "unsupported", "budget_exceeded", "invalid"]},
    "status_reason": {"type": ["string", "null"]},
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "job_name", "writer_rank"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "job_name": {"type": "string", "minLength": 1},
        "writer_rank": {"const": 0}
      }
    },
    "capability_signature": {"$ref": "#/$defs/runtime_signature"},
    "capability_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "moe"],
      "properties": {
        "attention": {"$ref": "#/$defs/capability_state"},
        "moe": {"$ref": "#/$defs/capability_state"}
      }
    },
    "capability_allow": {"$ref": "#/$defs/capability_allow"},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dp", "tp", "pp", "cp", "ep", "vpp", "num_layers", "layer_pp_owners"],
      "properties": {
        "dp": {"type": "integer", "minimum": 1},
        "tp": {"type": "integer", "minimum": 1},
        "pp": {"type": "integer", "minimum": 1},
        "cp": {"type": "integer", "minimum": 1},
        "ep": {"type": "integer", "minimum": 1},
        "vpp": {"type": "integer", "minimum": 1},
        "num_layers": {"type": "integer", "minimum": 1},
        "layer_pp_owners": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector", "seed", "selected_sample_id_hashes", "valid_position_count",
        "selected_sample_ids_sha256", "valid_token_ids_sha256"
      ],
      "properties": {
        "selector": {"const": "global_topk_hash_v1"},
        "seed": {"type": "integer"},
        "selected_sample_id_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "valid_position_count": {"type": "integer", "minimum": 1},
        "selected_sample_ids_sha256": {"$ref": "#/$defs/sha256"},
        "valid_token_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_sha256_by_rank", "selected_sample_ids_sha256_by_rank",
        "valid_token_ids_sha256_by_rank"
      ],
      "properties": {
        "descriptor_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "selected_sample_ids_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "valid_token_ids_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"}
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "family"],
      "properties": {
        "metric": {"$ref": "#/$defs/enum_dictionary"},
        "family": {"$ref": "#/$defs/enum_dictionary"}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_metrics.npz", "rank_perf.npz"],
      "properties": {
        "layer_metrics.npz": {"$ref": "#/$defs/npz_file"},
        "rank_perf.npz": {"$ref": "#/$defs/npz_file"}
      }
    },
    "state_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre", "post", "midpoint"],
      "properties": {
        "pre": {"$ref": "#/$defs/state_snapshot"},
        "post": {"$ref": "#/$defs/state_snapshot"},
        "midpoint": {"$ref": "#/$defs/state_snapshot"}
      }
    },
    "restore_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "optimizer", "rng", "mutable_state", "data_iterator",
        "fp8", "router", "cache"
      ],
      "properties": {
        "model": {"$ref": "#/$defs/restore_evidence"},
        "optimizer": {"$ref": "#/$defs/restore_evidence"},
        "rng": {"$ref": "#/$defs/restore_evidence"},
        "mutable_state": {"$ref": "#/$defs/restore_evidence"},
        "data_iterator": {"$ref": "#/$defs/restore_evidence"},
        "fp8": {"$ref": "#/$defs/restore_evidence"},
        "router": {"$ref": "#/$defs/restore_evidence"},
        "cache": {"$ref": "#/$defs/restore_evidence"}
      }
    },
    "process_groups": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/process_group_evidence"}
    },
    "artifact_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compressed", "uncompressed"],
      "properties": {
        "compressed": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "uncompressed": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaling_commit", "megatron_commit", "resolved_config_sha256",
        "scaling_bundle_sha256", "megatron_bundle_sha256"
      ],
      "properties": {
        "scaling_commit": {"$ref": "#/$defs/git_sha"},
        "megatron_commit": {"$ref": "#/$defs/git_sha"},
        "resolved_config_sha256": {"$ref": "#/$defs/sha256"},
        "scaling_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "megatron_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rank_hashes": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "capability_state": {"enum": ["available", "unsupported", "not_applicable"]},
    "capability_allow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_vpp", "allow_ep", "allow_fsdp",
        "allow_fp8_parameters", "allow_fp4_parameters"
      ],
      "properties": {
        "allow_vpp": {"const": false},
        "allow_ep": {"const": false},
        "allow_fsdp": {"const": false},
        "allow_fp8_parameters": {"const": false},
        "allow_fp4_parameters": {"const": false}
      }
    },
    "runtime_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimizer", "precision", "dp", "tp", "pp", "cp", "ep", "vpp",
        "moe", "fsdp", "chained_optimizer", "layerwise_optimizer",
        "overlap_param_gather", "parameter_cache_mode"
      ],
      "properties": {
        "optimizer": {"type": "string", "minLength": 1},
        "precision": {"type": "string", "minLength": 1},
        "dp": {"type": "integer", "minimum": 1},
        "tp": {"type": "integer", "minimum": 1},
        "pp": {"type": "integer", "minimum": 1},
        "cp": {"type": "integer", "minimum": 1},
        "ep": {"type": "integer", "minimum": 1},
        "vpp": {"type": "integer", "minimum": 1},
        "moe": {"type": "boolean"},
        "fsdp": {"type": "boolean"},
        "chained_optimizer": {"type": "boolean"},
        "layerwise_optimizer": {"type": "boolean"},
        "overlap_param_gather": {"type": "boolean"},
        "parameter_cache_mode": {"type": "string", "minLength": 1}
      }
    },
    "enum_dictionary": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "array_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "sha256"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "npz_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "arrays"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "arrays": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/array_descriptor"}
        }
      }
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable", "model_sha256_by_rank", "optimizer_sha256_by_rank",
        "model_sha256", "optimizer_sha256", "model_consensus_sha256_by_rank",
        "optimizer_consensus_sha256_by_rank"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "model_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "optimizer_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "model_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "optimizer_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "model_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "optimizer_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "restore_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable", "before_sha256_by_rank", "after_sha256_by_rank",
        "before_sha256", "after_sha256", "before_consensus_sha256_by_rank",
        "after_consensus_sha256_by_rank"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "before_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "after_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "before_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "after_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "before_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "after_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "collective_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "bytes"],
      "properties": {
        "name": {
          "enum": ["all_reduce", "all_gather", "reduce_scatter", "broadcast", "barrier"]
        },
        "count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "process_group_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "membership_sha256_by_rank", "operations"],
      "properties": {
        "name": {"enum": ["world", "dp", "tp", "pp", "cp", "ep"]},
        "membership_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "operations": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/collective_operation"}
        }
      }
    }
  }
}
