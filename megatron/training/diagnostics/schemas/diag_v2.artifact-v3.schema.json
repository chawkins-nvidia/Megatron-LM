{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab-master.nvidia.com/chawkins/scaling/schemas/diag_v2.artifact-v3.schema.json",
  "title": "diag/v2 promotion-capable all-layer event artifact v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "successful_update", "consumed_tokens", "event_id",
    "requested_tier", "effective_tier", "require_tier", "status", "status_reason",
    "run_identity", "capability_signature", "capability_status", "capability_allow",
    "topology", "sampling", "digests", "enums", "files", "state_snapshots",
    "restore_evidence", "secant_restore_evidence", "process_groups",
    "collective_contract", "artifact_bytes", "repro"
  ],
  "properties": {
    "schema": {"const": "diag/v2/artifact-v3"},
    "successful_update": {"type": "integer", "minimum": 1},
    "consumed_tokens": {"type": "integer", "minimum": 0},
    "event_id": {"type": "integer", "minimum": 1},
    "requested_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "effective_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "require_tier": {"type": "integer", "minimum": 0, "maximum": 2},
    "status": {"enum": ["ok", "degraded", "unsupported", "budget_exceeded", "invalid"]},
    "status_reason": {"type": ["string", "null"]},
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "job_name", "training_job_id", "writer_rank"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "job_name": {"type": "string", "minLength": 1},
        "training_job_id": {"type": "string", "pattern": "^[0-9]+(?:_[0-9]+)?$"},
        "writer_rank": {"type": "integer", "minimum": 0}
      }
    },
    "capability_signature": {"$ref": "#/$defs/runtime_signature_v3"},
    "capability_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "moe"],
      "properties": {
        "attention": {"$ref": "#/$defs/capability_state"},
        "moe": {"$ref": "#/$defs/capability_state"}
      }
    },
    "capability_allow": {"$ref": "#/$defs/capability_allow"},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dp", "tp", "pp", "cp", "ep", "vpp", "num_layers", "layer_pp_owners"],
      "properties": {
        "dp": {"type": "integer", "minimum": 1},
        "tp": {"type": "integer", "minimum": 1},
        "pp": {"type": "integer", "minimum": 1},
        "cp": {"type": "integer", "minimum": 1},
        "ep": {"type": "integer", "minimum": 1},
        "vpp": {"type": "integer", "minimum": 1},
        "num_layers": {"type": "integer", "minimum": 1},
        "layer_pp_owners": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sampling": {
      "oneOf": [
        {"$ref": "#/$defs/tier0_sampling"},
        {"$ref": "#/$defs/identity_sampling"}
      ]
    },
    "digests": {
      "oneOf": [
        {"$ref": "#/$defs/tier0_digests"},
        {"$ref": "#/$defs/identity_digests"}
      ]
    },
    "enums": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "family"],
      "properties": {
        "metric": {"$ref": "#/$defs/enum_dictionary"},
        "family": {"$ref": "#/$defs/enum_dictionary"}
      }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_metrics.npz", "rank_perf.npz"],
      "properties": {
        "layer_metrics.npz": {"$ref": "#/$defs/npz_file"},
        "rank_perf.npz": {"$ref": "#/$defs/npz_file"}
      }
    },
    "state_snapshots": {
      "type": "object", "additionalProperties": false,
      "required": ["pre", "post", "midpoint"],
      "properties": {
        "pre": {"$ref": "#/$defs/state_snapshot_v3"},
        "post": {"$ref": "#/$defs/state_snapshot_v3"},
        "midpoint": {"$ref": "#/$defs/state_snapshot_v3"}
      }
    },
    "restore_evidence": {"$ref": "#/$defs/restore_map"},
    "secant_restore_evidence": {"$ref": "#/$defs/restore_map"},
    "process_groups": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/process_group_evidence_v3"}
    },
    "collective_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "per_layer_collectives", "operations_by_group"],
      "properties": {
        "name": {"enum": ["tier0_mask_population_checksum_v1", "fixed_global_topk_hash_v1"]},
        "per_layer_collectives": {"const": false},
        "operations_by_group": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"enum": ["world", "dp", "tp", "pp", "cp", "ep"]},
          "additionalProperties": {
            "type": "array", "items": {"$ref": "#/$defs/collective_operation_v3"}
          }
        }
      }
    },
    "artifact_bytes": {
      "type": "object", "additionalProperties": false,
      "required": ["compressed", "uncompressed"],
      "properties": {
        "compressed": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "uncompressed": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    },
    "repro": {"$ref": "#/$defs/repro"}
  },
  "allOf": [
    {
      "if": {"properties": {"effective_tier": {"const": 0}}, "required": ["effective_tier"]},
      "then": {
        "properties": {
          "sampling": {"$ref": "#/$defs/tier0_sampling"},
          "digests": {"$ref": "#/$defs/tier0_digests"},
          "collective_contract": {
            "properties": {"name": {"const": "tier0_mask_population_checksum_v1"}}
          }
        }
      },
      "else": {
        "properties": {
          "sampling": {"$ref": "#/$defs/identity_sampling"},
          "digests": {"$ref": "#/$defs/identity_digests"},
          "collective_contract": {
            "properties": {"name": {"const": "fixed_global_topk_hash_v1"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rank_hashes": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "capability_state": {"enum": ["available", "unsupported", "not_applicable"]},
    "capability_allow": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_vpp", "allow_ep", "allow_fsdp", "allow_fp8_parameters", "allow_fp4_parameters"],
      "properties": {
        "allow_vpp": {"const": false},
        "allow_ep": {"const": false},
        "allow_fsdp": {"const": false},
        "allow_fp8_parameters": {"const": false},
        "allow_fp4_parameters": {"const": false}
      }
    },
    "optimizer_leaf": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "children"],
      "properties": {
        "name": {"enum": ["Adam", "AdamW", "FusedAdam"]},
        "children": {"const": []}
      }
    },
    "distributed_optimizer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "children"],
      "properties": {
        "name": {"const": "DistributedOptimizer"},
        "children": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/optimizer_leaf"}
        }
      }
    },
    "optimizer_chain": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "children"],
      "properties": {
        "name": {"const": "ChainedOptimizer"},
        "children": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/distributed_optimizer"}
        }
      }
    },
    "runtime_signature_v3": {
      "type": "object", "additionalProperties": false,
      "required": [
        "backend", "optimizer_chain", "precision", "dp", "tp", "pp", "cp", "ep", "vpp",
        "moe", "fsdp", "overlap_param_gather", "parameter_cache_mode"
      ],
      "properties": {
        "backend": {"const": "megatron"},
        "optimizer_chain": {"$ref": "#/$defs/optimizer_chain"},
        "precision": {"type": "string", "minLength": 1},
        "dp": {"type": "integer", "minimum": 1},
        "tp": {"type": "integer", "minimum": 1},
        "pp": {"type": "integer", "minimum": 1},
        "cp": {"type": "integer", "minimum": 1},
        "ep": {"type": "integer", "minimum": 1},
        "vpp": {"type": "integer", "minimum": 1},
        "moe": {"type": "boolean"},
        "fsdp": {"type": "boolean"},
        "overlap_param_gather": {"type": "boolean"},
        "parameter_cache_mode": {"type": "string", "minLength": 1}
      }
    },
    "tier0_sampling": {
      "type": "object", "additionalProperties": false,
      "required": [
        "selector", "seed", "mask_shape", "global_mask_population", "mask_population_by_rank",
        "global_mask_checksum", "mask_checksum_by_rank", "checksum_algorithm",
        "descriptor_sha256", "identity_disclaimer"
      ],
      "properties": {
        "selector": {"const": "tier0_mask_population_checksum_v1"},
        "seed": {"type": "integer"},
        "mask_shape": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "global_mask_population": {"type": "integer", "minimum": 0},
        "mask_population_by_rank": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "global_mask_checksum": {"type": "number"},
        "mask_checksum_by_rank": {
          "type": "array", "minItems": 1,
          "items": {"type": "number"}
        },
        "checksum_algorithm": {"const": "weighted_f32_summed_f64_v1"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "identity_disclaimer": {
          "const": "collision-prone population checksum; does not establish sample or token identity"
        }
      }
    },
    "identity_sampling": {
      "type": "object", "additionalProperties": false,
      "required": [
        "selector", "seed", "selected_sample_id_hashes", "valid_position_count",
        "selected_sample_ids_sha256", "valid_token_ids_sha256"
      ],
      "properties": {
        "selector": {"const": "global_topk_hash_v1"},
        "seed": {"type": "integer"},
        "selected_sample_id_hashes": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "valid_position_count": {"type": "integer", "minimum": 1},
        "selected_sample_ids_sha256": {"$ref": "#/$defs/sha256"},
        "valid_token_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tier0_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptor_sha256_by_rank"],
      "properties": {"descriptor_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"}}
    },
    "identity_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptor_sha256_by_rank", "selected_sample_ids_sha256_by_rank", "valid_token_ids_sha256_by_rank"],
      "properties": {
        "descriptor_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "selected_sample_ids_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "valid_token_ids_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"}
      }
    },
    "enum_dictionary": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "array_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["dtype", "shape", "sha256"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array", "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "npz_file": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "arrays"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "arrays": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/array_descriptor"}
        }
      }
    },
    "state_snapshot_v3": {
      "type": "object", "additionalProperties": false,
      "required": [
        "applicable", "reason", "model_sha256_by_rank", "optimizer_sha256_by_rank",
        "model_sha256", "optimizer_sha256", "model_consensus_sha256_by_rank",
        "optimizer_consensus_sha256_by_rank"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "model_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "optimizer_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "model_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "optimizer_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "model_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "optimizer_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "restore_evidence_v3": {
      "type": "object", "additionalProperties": false,
      "required": [
        "applicable", "reason", "before_sha256_by_rank", "after_sha256_by_rank",
        "before_sha256", "after_sha256", "before_consensus_sha256_by_rank",
        "after_consensus_sha256_by_rank"
      ],
      "properties": {
        "applicable": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "before_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "after_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "before_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "after_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "before_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "after_consensus_sha256_by_rank": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "restore_map": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "optimizer", "rng", "mutable_state", "data_iterator", "fp8", "router", "cache"],
      "properties": {
        "model": {"$ref": "#/$defs/restore_evidence_v3"},
        "optimizer": {"$ref": "#/$defs/restore_evidence_v3"},
        "rng": {"$ref": "#/$defs/restore_evidence_v3"},
        "mutable_state": {"$ref": "#/$defs/restore_evidence_v3"},
        "data_iterator": {"$ref": "#/$defs/restore_evidence_v3"},
        "fp8": {"$ref": "#/$defs/restore_evidence_v3"},
        "router": {"$ref": "#/$defs/restore_evidence_v3"},
        "cache": {"$ref": "#/$defs/restore_evidence_v3"}
      }
    },
    "collective_operation_v3": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "phase", "count", "bytes"],
      "properties": {
        "name": {"enum": ["all_reduce", "all_gather", "reduce_scatter", "broadcast", "barrier"]},
        "phase": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "process_group_evidence_v3": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "membership_ranks_by_rank", "membership_sha256_by_rank", "operations"],
      "properties": {
        "name": {"enum": ["world", "dp", "tp", "pp", "cp", "ep"]},
        "membership_ranks_by_rank": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          }
        },
        "membership_sha256_by_rank": {"$ref": "#/$defs/rank_hashes"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/collective_operation_v3"}}
      }
    },
    "repro": {
      "type": "object", "additionalProperties": false,
      "required": ["scaling_commit", "megatron_commit", "resolved_config_sha256", "scaling_bundle_sha256", "megatron_bundle_sha256"],
      "properties": {
        "scaling_commit": {"$ref": "#/$defs/git_sha"},
        "megatron_commit": {"$ref": "#/$defs/git_sha"},
        "resolved_config_sha256": {"$ref": "#/$defs/sha256"},
        "scaling_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "megatron_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
